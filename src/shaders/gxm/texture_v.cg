struct VertexInput {
    float3 position : POSITION;
    float2 uv : TEXCOORD0;
};

struct VertexOutput {
    float4 position : POSITION;
    float2 uv : TEXCOORD0;
};

float4x4 MVP;

VertexOutput main(VertexInput input) {
    VertexOutput output;
    output.position = mul(MVP, float4(input.position, 1.0));
    output.uv = input.uv;
    return output;
}